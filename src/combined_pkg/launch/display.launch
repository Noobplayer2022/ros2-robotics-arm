<?xml version="1.0" ?>
<launch>

    <!-- راه‌اندازی Gazebo World -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <!-- بارگذاری URDF مدل ربات (شامل بازو و نوار نقاله) -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find combined_pkg)/urdf/combine.urdf'"/>

    <!-- اسپاون کردن مدل ربات در Gazebo -->
    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
          args="-urdf -model robot_model -param robot_description"/>

    <!-- راه‌اندازی ربات استیت پابلشر -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

    <!-- راه‌اندازی RViz برای مشاهده وضعیت ربات -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robot_arm_urdf)/config/urdf.rviz" required="true"/>

    <!-- راه‌اندازی joint_state_publisher_gui برای کنترل دستی (اختیاری) -->
    <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />

    <!-- بارگذاری پارامترهای controller_manager -->
    <rosparam command="load" file="$(find combined_pkg)/config/controller.yaml" ns="/"/>

    <!-- بارگذاری پارامترهای کنترلر نوار نقاله -->
    <rosparam command="load" file="$(find combined_pkg)/config/conveyor_controller.yaml" ns="/"/>

    <!-- راه‌اندازی controller_manager و فعال کردن کنترلرها -->
    <node name="controller_manager" pkg="controller_manager" type="spawner"
          args="joint_state_controller
                joint_1_position_controller
                joint_2_position_controller
                joint_3_position_controller
                joint_4_position_controller
                joint_5_position_controller
                joint_6_position_controller
                joint_7_position_controller
                conveyor_joint_controller"
          output="screen"/>

</launch>